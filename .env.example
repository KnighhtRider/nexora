# Copy to `.env.local` and fill what you need. Never commit real values.
#
# Delivery provider for the two forms. "none" keeps the site honest:
#   development -> logs a sanitised payload and says so in the UI
#   production  -> POST returns 503 with a clear message (never a fake success)
CONTACT_PROVIDER=none

# Required only when CONTACT_PROVIDER=resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
